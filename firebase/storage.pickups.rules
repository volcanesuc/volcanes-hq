// =====================================================================
// PICKUPS — reglas de Storage
// Pegar DENTRO de:  service firebase.storage { match /b/{bucket}/o { ... } }
// =====================================================================

match /pickups/{pickupId}/proofs/{uid}/{fileName} {
  allow create: if request.auth != null
    && request.auth.uid == uid
    && request.resource.size < 8 * 1024 * 1024
    && request.resource.contentType.matches("image/.*");

  allow read: if request.auth != null && (
    request.auth.uid == uid
    || firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.get("role", "") == "admin"
  );

  allow update, delete: if false;
}
